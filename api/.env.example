NODE_ENV=production
PORT=3000
DATABASE_URL=
# verify-full verifies the database certificate. Use disable only on your private Railway database network.
DATABASE_SSL=verify-full
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Generate independent random values of at least 32 characters. No defaults are accepted.
ACCESS_TOKEN_SECRET=
UNSUBSCRIBE_SECRET=
ADMIN_USER=
# At least 16 characters.
ADMIN_PASS=
ADMIN_PATH=/admin
API_BASE_URL=https://app.stayhustler.com
PUBLIC_BASE_URL=https://stayhustler.com
# Optional. Reports are sent only when a recipient is explicitly configured.
REPORT_EMAIL=
# Optional, at least 32 characters. Missing secret disables the cron endpoint.
CRON_SECRET=
# Optional explicit proxy CIDRs. Default: one Railway ingress proxy.
TRUST_PROXY=
